# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# Optional free/simple LLM fallback.
# OpenRouter's free model router currently uses the model id "openrouter/free".
# Create a free OpenRouter key and set OPENROUTER_API_KEY to use it.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_API_URL="https://openrouter.ai/api/v1/chat/completions"

# Optional generic OpenAI-compatible fallback names.
# Use these instead of the OPENROUTER_* variables for another simple chat-completions API.
SIMPLE_LLM_API_KEY=""
SIMPLE_LLM_MODEL=""
SIMPLE_LLM_API_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
